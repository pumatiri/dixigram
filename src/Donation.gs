/**
 * DIXIGRAM — Donasi sukarela (QRIS).
 *
 * Aplikasi tetap gratis. Tombol donasi bisa dimatikan di
 * Admin → Pengaturan → Donasi. Gambar QRIS hanya dikirim saat jendela
 * donasi dibuka, jadi tidak memperberat pemuatan awal.
 *
 * Untuk mengganti QRIS: ubah DONATION.IMAGE_BASE64 dengan isi base64 file PNG baru
 * (mis. dari https://base64.guru/converter/encode/image), lalu deploy versi baru.
 */

var DONATION = Object.freeze({
  MERCHANT: 'BeeCOMP Servis',
  ORG: 'BeeComp Group',
  DEFAULT_MESSAGE: 'DIXIGRAM gratis untuk semua. Bila aplikasi ini bermanfaat, kamu bisa ikut mendukung pengembangannya lewat donasi seikhlasnya.',
  IMAGE_MIME: 'image/png',
  IMAGE_BASE64: ''
});

/** Data jendela donasi: pesan, nama penerima, dan gambar QRIS. Terbuka untuk semua. */
function apiDonation(token) {
  return api_(function () {
    const s = getSettings_();
    if (!s.donationEnabled) {
      // Admin tetap bisa melihat pratinjau walau tombol donasi dimatikan.
      let isAdminViewer = false;
      try { isAdminViewer = !!token && !!requireAdmin_(token); } catch (err) { isAdminViewer = false; }
      if (!isAdminViewer) throw apiError_('DONATION_OFF', 'Donasi sedang tidak dibuka.');
    }
    const base = publicBaseUrl_();
    return {
      message: s.donationMessage || DONATION.DEFAULT_MESSAGE,
      merchant: DONATION.MERCHANT,
      org: DONATION.ORG,
      image: 'data:' + DONATION.IMAGE_MIME + ';base64,' + DONATION.IMAGE_BASE64,
      imageUrl: base ? base + 'assets/qris.png' : ''
    };
  });
}
